# Android project ignores: keep local caches, build outputs, and machine settings out of Git.
.gradle/
.gradle-user/
**/build/
.idea/
.kotlin/
.agents/
local.properties
*.iml
.externalNativeBuild/
.cxx/

# Gradle/JVM crash diagnostics: machine-specific, never commit.
worker-info.log
hs_err_pid*.log

# Local environment and signing material.
.env
.env.*
!.env.example
*.jks
*.keystore

# OS and editor files.
.DS_Store
Thumbs.db

# Local scratch directory.
tmp/

# 实验性 / 一次性构建目录（例如排查问题时另建的 build-alex/）：不是源码，不入库。
# 刻意不写 **/build-*/，免得将来引入 build-logic/ 这类真正需要入库的目录时被误伤。
app/build-*/
