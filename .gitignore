# Android project ignores: keep local caches, build outputs, and machine settings out of Git.
.gradle/
.gradle-user/
**/build/
.idea/
.kotlin/
.agents/
local.properties
*.iml
.externalNativeBuild/
.cxx/

# Gradle/JVM crash diagnostics: machine-specific, never commit.
worker-info.log
hs_err_pid*.log

# Local environment and signing material.
.env
.env.*
!.env.example
*.jks
*.keystore

# OS and editor files.
.DS_Store
Thumbs.db
