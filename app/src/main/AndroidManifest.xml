<?xml version="1.0" encoding="utf-8"?>
<!-- 更新检查使用网络，APK 下载后交给系统安装器处理。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 不申请 CAMERA 权限：拍照由系统相机处理；Photo Picker 也无需存储权限。 -->

    <!-- 本地优先：照片是个人证书材料，allowBackup=false，绝不参与系统云备份。 -->
    <application
        android:name=".ZongceApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zongce"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Zongce">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            桌面小组件之一：快速录入。只承载「拍照 / 相册」两个入口，点击后把带 action 的
            Intent 交给 MainActivity（singleTop），由它转发给录入页。组件本身不碰数据库、
            不保存照片。exported=false 沿用 AppWidget 的常规写法：广播由系统发出，无需对外暴露。
        -->
        <receiver
            android:name=".widget.JicunWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jicun_widget_info" />
        </receiver>

        <!--
            桌面小组件之二：成果概览（RemoteViews 版）。与上面那个是彼此独立的组件，用户可在桌面上分别添加。
            本组件会读 Room 做展示（只读，绝不写入），数据变化时由 AppViewModel 主动推送刷新；
            这与上面那个"不碰数据库"的约束不同，理由见 docs/adr/0002。
            切学年不再弹 Activity：头部 ‹ › 箭头广播回本接收器就地切换。
        -->
        <receiver
            android:name=".widget.AchievementListWidget"
            android:exported="false"
            android:label="@string/achievement_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/jicun_achievement_widget_info" />
        </receiver>

        <!--
            成果概览小组件的列表数据源（RemoteViewsService）。
            BIND_REMOTEVIEWS_SERVICE 是系统签名权限：声明后只有系统（launcher）能绑定，
            第三方 App 无法冒充桌面进程拉取用户数据。
        -->
        <service
            android:name=".widget.AchievementListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS_SERVICE">
            <intent-filter>
                <action android:name="android.appwidget.action.REMOTEVIEWS_SERVICE" />
            </intent-filter>
        </service>

        <!-- 拍照临时文件 & 导出 ZIP 分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
