<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件的系统登记信息。
  规格：3×2 格（约 180×110dp），可横向/纵向拉伸；只在桌面出现；不主动定时刷新
  （updatePeriodMillis=0，内容全是静态入口，没有需要轮询的数据）。
  initialLayout 必须指向 Glance 自带的占位布局，真实内容由 JicunWidget 渲染进去。
  previewLayout 是桌面组件选择器里显示的预览（API 31+）。不声明的话系统会拿应用图标
  当预览，用户在添加组件时根本看不到它长什么样。
  另补 previewImage 预渲染位图（drawable-nodpi/widget_preview_entry_img.png，由 tmp/
  gen_widget_previews.py 生成）：ColorOS 的「原子组件」选择器不渲染 previewLayout，
  会回落到应用图标，位图兜底；两者共存。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget_preview_entry_img"
    android:previewLayout="@layout/widget_preview_entry"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
