<?xml version="1.0" encoding="utf-8"?>
<!--
  成果概览小组件的系统登记信息。
  与 jicun_widget_info.xml（快速录入）是两个彼此独立的组件，用户在桌面的组件选择器里
  会看到两个条目，可以分别添加。
  规格：3×2 格（约 180×110dp），可横向/纵向拉伸；只在桌面出现。
  updatePeriodMillis=0：不靠定时轮询，由 AppViewModel.refreshWidget() 在保存/删除记录后主动推送。
  本组件对 Room 只读，不写、不参与照片生命周期（见 docs/adr/0002）。
  initialLayout 必须指向 Glance 自带的占位布局，真实内容由 JicunAchievementWidget 渲染进去。
  previewImage 是预渲染位图（drawable-nodpi/widget_preview_achievement_img.png，由 tmp/
  gen_widget_previews.py 生成）：ColorOS 的「原子组件」选择器不渲染 previewLayout，会回落到
  应用图标，位图兜底；API 31+ 支持的启动器继续用 previewLayout，两者共存。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/achievement_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minWidth="180dp"
    android:previewImage="@drawable/widget_preview_achievement_img"
    android:previewLayout="@layout/widget_preview_achievement"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
